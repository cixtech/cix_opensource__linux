# android configs
CONFIG_CHROME_PLATFORMS=y
# CONFIG_CHROMEOS_ACPI is not set
# CONFIG_CHROMEOS_TBMC is not set
CONFIG_CROS_EC=y
CONFIG_CROS_EC_I2C=y
CONFIG_CROS_EC_RPMSG=m
CONFIG_CROS_EC_SPI=y
# CONFIG_CROS_EC_UART is not set
CONFIG_CROS_EC_PROTO=y
# CONFIG_CROS_KBD_LED_BACKLIGHT is not set
CONFIG_CROS_EC_CHARDEV=m
CONFIG_CROS_EC_LIGHTBAR=y
CONFIG_CROS_EC_VBC=y
CONFIG_CROS_EC_DEBUGFS=y
CONFIG_CROS_EC_SENSORHUB=y
CONFIG_CROS_EC_SYSFS=y
CONFIG_CROS_EC_TYPEC=m
# CONFIG_CROS_HPS_I2C is not set
CONFIG_CROS_USBPD_NOTIFY=y
# CONFIG_CHROMEOS_PRIVACY_SCREEN is not set
CONFIG_CROS_TYPEC_SWITCH=m
CONFIG_CIX_EC=y
CONFIG_NTFS_FS=y
COFNIG_NTFS_RW=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_PROTECT=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_ARM64_SVE=n
CONFIG_WERROR=n
CONFIG_CIX_DST=n
CONFIG_MTD=m
CONFIG_MTD_BLKDEVS=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_PHRAM=m
CONFIG_ARM_SMMU_V3=y
CONFIG_RANDOM_TRUST_BOOTLOADER=y
CONFIG_CRYPTO_SHA1=y
CONFIG_SECTION_MISMATCH_WARN_ONLY=y
#Power management configs
CONFIG_ARM_SCMI_POWER_DOMAIN=y
#hwmon
CONFIG_HWMON=y
# ARM dma350 driver
CONFIG_ARM_DMA350=m
#optee driver
CONFIG_TEE=y
CONFIG_OPTEE=y
# for usb
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_DUMMY_HCD=n
CONFIG_USB_F_NCM=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_SPI_ATTRS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_DRIVERS=y
#for i2c
CONFIG_REGMAP_I2C=y
CONFIG_I2C=y
CONFIG_ACPI_I2C_OPREGION=y
CONFIG_I2C_BOARDINFO=y
CONFIG_I2C_COMPAT=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MUX=y
CONFIG_I2C_HELPER_AUTO=y
CONFIG_I2C_ALGOBIT=y
CONFIG_I2C_BRCMSTB=y
CONFIG_I2C_SLAVE=y
CONFIG_MMC5633_I2C=y
#for spi
CONFIG_REGMAP_SPI=y
CONFIG_SPI_CADENCE_QUADSPI=y
CONFIG_SPI_DESIGNWARE=m
CONFIG_SPI_DW_DMA=y
CONFIG_SPI_DYNAMIC=y
#for pinctrl
CONFIG_PINCTRL=y
CONFIG_GENERIC_PINCTRL_GROUPS=y
CONFIG_PINMUX=y
CONFIG_GENERIC_PINMUX_FUNCTIONS=y
CONFIG_PINCONF=y
CONFIG_GENERIC_PINCONF=y
#for gpio
CONFIG_GPIOLIB=y
CONFIG_GPIOLIB_FASTPATH_LIMIT=512
CONFIG_OF_GPIO=y
CONFIG_GPIO_ACPI=y
CONFIG_GPIOLIB_IRQCHIP=y
CONFIG_GPIO_CDEV=y
CONFIG_GPIO_CDEV_V1=y
CONFIG_GPIO_GENERIC=y
#for gmac
CONFIG_MACB=y
CONFIG_PHYLINK=y
#for dp
CONFIG_DRM_TRILIN_DPSUB=y
CONFIG_DRM_CIX_EDP_PANEL=y
CONFIG_DRM_TRILIN_DP_CIX=y
CONFIG_DRM_TRILIN_CADENCE_PHY=y
CONFIG_DRM_PANEL_EDP=y
CONFIG_LINLON_AEU=y
#for i2c-hid
CONFIG_I2C_HID_OF=y
CONFIG_I2C_HID_CORE=y
CONFIG_UHID=y
# disbale config in cix.config
CONFIG_BPFILTER=n
CONFIG_INET_UDP_DIAG=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NETFILTER_XT_TARGET_TRACE=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NFSD=n
CONFIG_XFRM_INTERFACE=y
#for RTC
CONFIG_OF=y
CONFIG_RTC_DRV_HYM8563=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y
CONFIG_MAILBOX=y
CONFIG_BPF_SYSCALL=y
CONFIG_HW_RANDOM=y
CONFIG_CFI_CLANG=n
CONFIG_UBSAN=n

CONFIG_PTP_1588_CLOCK=y
CONFIG_PTP_1588_CLOCK_OPTIONAL=y
CONFIG_PTP_1588_CLOCK_KVM=y
