#!/bin/sh
set -e

DKMS_NAME=armcb-isp
DKMS_VER=1.0.0

case "$1" in
    configure)
        set +e
        if command -v dkms >/dev/null 2>&1; then
            if ! dkms status -m "$DKMS_NAME" -v "$DKMS_VER" 2>/dev/null | grep -q .; then
                dkms add -m "$DKMS_NAME" -v "$DKMS_VER"
            fi
            if dkms build -m "$DKMS_NAME" -v "$DKMS_VER"; then
                dkms install -m "$DKMS_NAME" -v "$DKMS_VER" --force
            else
                echo "WARNING: dkms build failed for $DKMS_NAME/$DKMS_VER." >&2
                echo "  Install: dkms, build-essential, linux-headers-\$(uname -r)" >&2
                echo "  Log: /var/lib/dkms/$DKMS_NAME/$DKMS_VER/build/make.log" >&2
                echo "  Retry: sudo dkms install -m $DKMS_NAME -v $DKMS_VER" >&2
            fi
        fi
        set -e
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

#DEBHELPER#

exit 0
